# syntax=docker/dockerfile:1.7
# Builds apps/worker for the eyeq-worker Container Apps Job (phase 6) and,
# with a different command, the eyeq-migrate job.
# Build from the repo root:  docker build -f docker/Dockerfile.worker -t eyeq-worker .

FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/db/package.json packages/db/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store pnpm install --frozen-lockfile --filter worker...

FROM deps AS build
COPY packages/config packages/config
COPY packages/db packages/db
COPY apps/worker apps/worker
COPY db db
RUN pnpm --filter worker build

FROM build AS runner
ENV NODE_ENV=production
USER node
# Default: one worker run. The migrate job overrides with:
#   pnpm --filter @eyeq/db migrate
CMD ["node", "apps/worker/dist/index.js"]
