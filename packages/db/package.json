{
  "name": "@eyeq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kysely client, generated types, typed wrappers for SQL functions, and the migration runner",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts up",
    "reset": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts reset",
    "test:pg": "node --env-file-if-exists=../../.env --import tsx src/pgtest.ts",
    "codegen": "kysely-codegen --dialect postgres --env-file ../../.env --out-file src/generated/schema.ts",
    "migrate:status": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts status"
  },
  "dependencies": {
    "kysely": "^0.28.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eyeq/config": "workspace:*",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.33.0",
    "kysely-codegen": "^0.19.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
