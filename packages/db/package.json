{
  "name": "@eyeq/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Prisma client (introspected from db/migrations), typed helpers, and the SQL migration runner",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts up",
    "reset": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts reset",
    "test:pg": "node --env-file-if-exists=../../.env --import tsx src/pgtest.ts",
    "codegen": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js db pull && prisma format && prisma generate",
    "migrate:status": "node --env-file-if-exists=../../.env --import tsx src/migrate.ts status",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/seed.ts",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "generate": "prisma generate",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@eyeq/config": "workspace:*",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "eslint": "^9.33.0",
    "prisma": "7.10.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
