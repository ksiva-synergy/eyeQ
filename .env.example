# Copy to .env for local development. Every variable the plan names is listed;
# unused ones are commented out until the phase that introduces them.
# On Vercel these are project environment variables (rule 12). Nothing secret is ever
# NEXT_PUBLIC_*.

# --- Database (phase 0+) --------------------------------------------------
# Admin URL for migrate/reset/test/seed and the Prisma CLI (db pull). Local compose:
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eyeq
# Local Supabase image (`pnpm db:supabase:up`), for parity with hosted Supabase:
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Hosted Supabase: the SESSION pooler (port 5432; IPv4) or the direct host. Never 6543 here.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
#
# Runtime roles (phase 1 creates them; phase 2 wires them). On Vercel use Supabase's
# TRANSACTION pooler (port 6543); custom roles log in as <role>.<project-ref>.
# DATABASE_URL_API=postgresql://eyeq_api.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_URL_SERVICE=postgresql://eyeq_service.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
# DB_POOL_MAX=3

# --- App ------------------------------------------------------------------
NODE_ENV=development
# APP_URL=http://localhost:3000     # public origin, used for the Google redirect
# APP_ENV=local                     # local | test | staging | production
# DEV_GALLERY=1                     # /dev/components in a production build: 1 on staging and
#                                   # in CI, unset for real production; always on under next dev
# Locally, with only DATABASE_URL on a local host, the app connects as eyeq_api /
# eyeq_service through `-c role=...`, so RLS applies exactly as hosted.

# --- Auth: Supabase Auth (phase 2, D28) ------------------------------------
# Server-only. The browser never holds a Supabase key; sign-in goes through apps/web.
# Local (pnpm supabase:up): the API URL and anon key from `pnpm supabase:status`.
# SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=
# The Send SMS hook secret, "v1,whsec_<base64>". scripts/supabase-env.mjs writes a local
# one to supabase/.env; copy that line here.
# SEND_SMS_HOOK_SECRET=
# SMS_PROVIDER=console              # console (local only) | test (staging) | msg91 (production)
# OTP_TEST_PHONE=+919000000001      # staging: the only number the test sender accepts
# MSG91_AUTH_KEY=                   # before real users (DLT-registered sender and template)
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# The service-role key is never used by this app and never set anywhere in it.
# Google and Apple OAuth clients are configured in Supabase Auth, not here.

# --- Storage (phase 4): Azurite locally until phase 4 settles Supabase Storage --
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# AZURE_STORAGE_PUBLIC_CONTAINER=public
# AZURE_STORAGE_PRIVATE_CONTAINER=private
# PUBLIC_ASSETS_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/public

# --- Google APIs (phase 4 link check) --------------------------------------
# YouTube Data API v3 and Drive API, restricted to those two APIs. Server-only.
# Unset locally and in CI: an offline stub checks links (refs starting "dead" are
# missing, "priv" private). Unset on staging or production: links stay unchecked
# and a program cannot be published.
# GOOGLE_API_KEY=

# --- Payments (phases 7, 9) -----------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=

# --- Messaging (phases 6, 9) -----------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=
# EXPO_ACCESS_TOKEN=

# --- Observability (phase 2) ----------------------------------------------
# Each is skipped cleanly when unset. Logs are JSON lines on stdout (Vercel logs).
# SENTRY_DSN=                       # server
# NEXT_PUBLIC_SENTRY_DSN=           # browser; a DSN is public by design, not a secret
# NEXT_PUBLIC_APP_ENV=local
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_AUTH_TOKEN=                # build only, for source maps (with SENTRY_ORG, SENTRY_PROJECT)
# SENTRY_ORG=
# SENTRY_PROJECT=
# POSTHOG_API_KEY=                  # server client and feature flags
# POSTHOG_HOST=https://eu.i.posthog.com

# --- Support links read from config (phase 5) -----------------------------
# SUPPORT_WHATSAPP_URL=
