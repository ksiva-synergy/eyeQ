# Copy to .env for local development. Every variable the plan names is listed;
# unused ones are commented out until the phase that introduces them.
# In Azure these are Key Vault references read through the managed identity (rule 12).

# --- Database (phase 0+) --------------------------------------------------
# Local compose stack. The migrate/reset/test scripts use this role.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/eyeq
# Runtime roles (phase 1 creates them; phase 2 wires them):
# DATABASE_URL_API=postgres://eyeq_api:eyeq_api@localhost:5432/eyeq
# DATABASE_URL_SERVICE=postgres://eyeq_service:eyeq_service@localhost:5432/eyeq
# DB_POOL_MAX=10

# --- App ------------------------------------------------------------------
NODE_ENV=development
# APP_URL=http://localhost:3000
# APP_ENV=local            # local | staging | production

# --- Auth: Better Auth (phase 2) ------------------------------------------
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=           # phase 9
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=
# SMS_PROVIDER=console       # console | msg91 | test
# MSG91_AUTH_KEY=
# MSG91_SENDER_ID=
# MSG91_OTP_TEMPLATE_ID=
# OTP_TEST_PHONE=            # staging only: a fixed number that accepts OTP_TEST_CODE
# OTP_TEST_CODE=

# --- Storage: Azure Blob / Azurite (phase 4) ------------------------------
# AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# AZURE_STORAGE_PUBLIC_CONTAINER=public
# AZURE_STORAGE_PRIVATE_CONTAINER=private
# PUBLIC_ASSETS_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/public

# --- Google APIs (phase 4 link check) --------------------------------------
# GOOGLE_API_KEY=

# --- Payments (phases 7, 9) -----------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# REVENUECAT_API_KEY=
# REVENUECAT_WEBHOOK_AUTH=

# --- Messaging (phases 6, 9) -----------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=
# EXPO_ACCESS_TOKEN=

# --- Observability (phase 2) ----------------------------------------------
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# POSTHOG_API_KEY=
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Support links read from config (phase 5) -----------------------------
# SUPPORT_WHATSAPP_URL=
