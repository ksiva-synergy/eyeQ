{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "auth:e2e": "node --env-file-if-exists=../../.env --import tsx scripts/auth-e2e.ts",
    "concurrency:check": "node --env-file-if-exists=../../.env --import tsx scripts/concurrency-check.ts",
    "check:data-api": "node --env-file-if-exists=../../.env --import tsx scripts/check-data-api.ts",
    "razorpay:sync-plans": "node --env-file-if-exists=../../.env --import tsx scripts/razorpay-sync-plans.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@eyeq/api-contract": "workspace:*",
    "@eyeq/config": "workspace:*",
    "@eyeq/db": "workspace:*",
    "@eyeq/game": "workspace:*",
    "@eyeq/i18n": "workspace:*",
    "@eyeq/ui": "workspace:*",
    "@sentry/nextjs": "10.75.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.0",
    "posthog-js": "1.434.15",
    "posthog-node": "5.54.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "standardwebhooks": "1.1.1",
    "web-push": "3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
