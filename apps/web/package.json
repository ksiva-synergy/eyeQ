{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "start:standalone": "node scripts/start-standalone.mjs",
    "test:integration": "node --env-file-if-exists=../../.env --import tsx node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "auth:e2e": "node --env-file-if-exists=../../.env --import tsx scripts/auth-e2e.ts",
    "check:data-api": "node --env-file-if-exists=../../.env --import tsx scripts/check-data-api.ts"
  },
  "dependencies": {
    "@eyeq/api-contract": "workspace:*",
    "@eyeq/config": "workspace:*",
    "@eyeq/db": "workspace:*",
    "@eyeq/game": "workspace:*",
    "@eyeq/i18n": "workspace:*",
    "@eyeq/ui": "workspace:*",
    "@sentry/nextjs": "10.75.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.4.0",
    "posthog-node": "5.54.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "standardwebhooks": "1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
