{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "doctor": "pnpm dlx expo-doctor@1.21.5",
    "bundle:check": "expo export --platform android --platform ios --output-dir dist --no-minify"
  },
  "dependencies": {
    "@eyeq/api-contract": "workspace:*",
    "@eyeq/i18n": "workspace:*",
    "@eyeq/ui": "workspace:*",
    "@tanstack/react-query": "^5.104.3",
    "expo": "~58.0.14",
    "expo-build-properties": "~58.0.0",
    "expo-constants": "~58.0.12",
    "expo-crypto": "~58.0.0",
    "expo-dev-client": "~58.0.0",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "expo-updates": "~58.0.0",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eyeq/config": "workspace:*",
    "@types/react": "~19.3.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
