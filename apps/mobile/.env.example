# apps/mobile/.env (gitignored). Expo CLI reads it; EXPO_PUBLIC_* values are built into the
# app, so nothing secret goes here (rule 12).
# The app server. On an Android emulator, 10.0.2.2 is the host machine; on a phone, use the
# Mac's LAN address. Staging builds get https://eyeq-nu.vercel.app from eas.json.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
