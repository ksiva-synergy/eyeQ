{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Scheduled sender: drains the notifications outbox (push, email). Runs to completion every 5 minutes as a Container Apps Job (phase 6).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@eyeq/db": "workspace:*",
    "kysely": "^0.28.5"
  },
  "devDependencies": {
    "@eyeq/config": "workspace:*",
    "@types/node": "^22.17.2",
    "eslint": "^9.33.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
