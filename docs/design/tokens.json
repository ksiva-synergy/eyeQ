{
  "$description": "EyeQ by Forge Your Peak — design tokens v1.0. DTCG-style ($value / $type). Dimensions are px strings; strip the unit for React Native. Values are fully resolved (no {alias} references), so Expo and Next.js can read the file directly or run it through Style Dictionary.",
  "color": {
    "dark": {
      "$description": "Primary theme.",
      "ground": { "$type": "color", "$value": "#0B0B10", "$description": "App background" },
      "surface-1": { "$type": "color", "$value": "#15151D", "$description": "Cards" },
      "surface-2": {
        "$type": "color",
        "$value": "#1E1E28",
        "$description": "Raised elements on cards, inputs, chips"
      },
      "surface-tabbar": { "$type": "color", "$value": "#0F0F15" },
      "border": { "$type": "color", "$value": "#2A2A37", "$description": "1px hairline" },
      "border-strong": {
        "$type": "color",
        "$value": "#34344A",
        "$description": "Sheets, toasts, raised cards"
      },
      "text-primary": { "$type": "color", "$value": "#F3F2F8" },
      "text-secondary": { "$type": "color", "$value": "#A9A8B8" },
      "text-muted": {
        "$type": "color",
        "$value": "#8E8DA0",
        "$description": "Also the colour of loss / ended states. Loss is never red."
      },
      "text-disabled": { "$type": "color", "$value": "#6E6D7E" },
      "scrim": {
        "$type": "color",
        "$value": "#000000A0",
        "$description": "Black 60 % behind sheets and modals"
      },

      "primary": {
        "$type": "color",
        "$value": "#7C3AED",
        "$description": "Violet fill: primary buttons, selected states, progress fills, level badges"
      },
      "primary-text": {
        "$type": "color",
        "$value": "#B197FC",
        "$description": "Violet as text or icon on ground / surfaces"
      },
      "primary-subtle": {
        "$type": "color",
        "$value": "#241B3F",
        "$description": "Tint behind violet content; selected rows; Today card"
      },
      "primary-subtle-border": { "$type": "color", "$value": "#3B2A66" },
      "primary-on-subtle": {
        "$type": "color",
        "$value": "#D4C6FF",
        "$description": "Body text on primary-subtle"
      },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },

      "cta": {
        "$type": "color",
        "$value": "#DA2141",
        "$description": "The one action per screen. Never for loss or alerts."
      },
      "cta-text": {
        "$type": "color",
        "$value": "#FF6B81",
        "$description": "Destructive actions only"
      },
      "cta-subtle": { "$type": "color", "$value": "#3A1118" },
      "on-cta": { "$type": "color", "$value": "#FFFFFF" },

      "streak": {
        "$type": "color",
        "$value": "#FFB020",
        "$description": "Ember: streak flame and count. Fill and text."
      },
      "streak-subtle": { "$type": "color", "$value": "#2B2308" },
      "streak-border": { "$type": "color", "$value": "#8A6400" },
      "on-streak": { "$type": "color", "$value": "#15141D" },

      "xp": {
        "$type": "color",
        "$value": "#FFD23F",
        "$description": "Gold: XP and coins. Fill and text."
      },
      "xp-subtle": { "$type": "color", "$value": "#2B2308" },
      "xp-border": { "$type": "color", "$value": "#5C4A0E" },
      "on-xp": { "$type": "color", "$value": "#15141D" },

      "success": { "$type": "color", "$value": "#1F9D5A", "$description": "Fill" },
      "success-text": { "$type": "color", "$value": "#3DD68C" },
      "success-subtle": { "$type": "color", "$value": "#13261B" },
      "success-border": { "$type": "color", "$value": "#2E6B45" },

      "rank": {
        "$type": "color",
        "$value": "#1B4F7A",
        "$description": "Sky fill. Also streak-freeze."
      },
      "rank-text": {
        "$type": "color",
        "$value": "#5AB4FF",
        "$description": "Rank numbers, rank-down delta, frozen streak"
      },
      "rank-subtle": { "$type": "color", "$value": "#112A44" },

      "podium-gold": { "$type": "color", "$value": "#FFD23F" },
      "podium-silver": { "$type": "color", "$value": "#A9A8B8" },
      "podium-bronze": { "$type": "color", "$value": "#C8824A" },

      "focus-ring": { "$type": "color", "$value": "#B197FC" }
    },
    "light": {
      "$description": "Secondary theme; also used by the coach admin and public web pages.",
      "ground": { "$type": "color", "$value": "#F5F4FA" },
      "surface-1": { "$type": "color", "$value": "#FFFFFF" },
      "surface-2": { "$type": "color", "$value": "#ECEAF4" },
      "surface-tabbar": { "$type": "color", "$value": "#FFFFFF" },
      "border": { "$type": "color", "$value": "#DCD9E8" },
      "border-strong": { "$type": "color", "$value": "#C9C5DA" },
      "text-primary": { "$type": "color", "$value": "#15141D" },
      "text-secondary": { "$type": "color", "$value": "#4F4D5E" },
      "text-muted": { "$type": "color", "$value": "#6E6C7E" },
      "text-disabled": { "$type": "color", "$value": "#9A98AA" },
      "scrim": { "$type": "color", "$value": "#00000080" },

      "primary": { "$type": "color", "$value": "#6D28D9" },
      "primary-text": { "$type": "color", "$value": "#5B21B6" },
      "primary-subtle": { "$type": "color", "$value": "#EFE9FF" },
      "primary-subtle-border": { "$type": "color", "$value": "#D9CCFF" },
      "primary-on-subtle": { "$type": "color", "$value": "#4C1D95" },
      "on-primary": { "$type": "color", "$value": "#FFFFFF" },

      "cta": { "$type": "color", "$value": "#C8102E" },
      "cta-text": { "$type": "color", "$value": "#B50E29" },
      "cta-subtle": { "$type": "color", "$value": "#FDE8EC" },
      "on-cta": { "$type": "color", "$value": "#FFFFFF" },

      "streak": {
        "$type": "color",
        "$value": "#F59E0B",
        "$description": "Fill only; use streak-text for text"
      },
      "streak-text": { "$type": "color", "$value": "#9A5B00" },
      "streak-subtle": { "$type": "color", "$value": "#FFF4CC" },
      "streak-border": { "$type": "color", "$value": "#F0D37A" },
      "on-streak": { "$type": "color", "$value": "#15141D" },

      "xp": {
        "$type": "color",
        "$value": "#FFD23F",
        "$description": "Fill only; use xp-text for text"
      },
      "xp-text": { "$type": "color", "$value": "#8A6400" },
      "xp-subtle": { "$type": "color", "$value": "#FFF4CC" },
      "xp-border": { "$type": "color", "$value": "#F0D37A" },
      "on-xp": { "$type": "color", "$value": "#15141D" },

      "success": { "$type": "color", "$value": "#1F9D5A" },
      "success-text": { "$type": "color", "$value": "#0F7A43" },
      "success-subtle": { "$type": "color", "$value": "#E6F6EC" },
      "success-border": { "$type": "color", "$value": "#BFE6CC" },

      "warning-text": {
        "$type": "color",
        "$value": "#8A5A00",
        "$description": "Admin validation (untitled drill, missing target)"
      },
      "warning-subtle": { "$type": "color", "$value": "#FFF4CC" },
      "warning-border": { "$type": "color", "$value": "#E0A800" },

      "rank": { "$type": "color", "$value": "#1B6FB8" },
      "rank-text": { "$type": "color", "$value": "#1B6FB8" },
      "rank-subtle": { "$type": "color", "$value": "#E3F0FB" },

      "podium-gold": { "$type": "color", "$value": "#8A6400" },
      "podium-silver": { "$type": "color", "$value": "#6E6C7E" },
      "podium-bronze": { "$type": "color", "$value": "#9A5B2A" },

      "focus-ring": { "$type": "color", "$value": "#6D28D9" }
    }
  },

  "font": {
    "family": {
      "display": {
        "$type": "fontFamily",
        "$value": ["Barlow Condensed", "Impact", "Arial Narrow", "sans-serif"],
        "$description": "Numbers, levels, headlines only. Weights 700 / 800."
      },
      "body": {
        "$type": "fontFamily",
        "$value": ["Manrope", "system-ui", "sans-serif"],
        "$description": "Everything else. Weights 500–800."
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "ui-monospace", "monospace"],
        "$description": "Coach admin bulk-paste field only"
      }
    },
    "weight": {
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "extrabold": { "$type": "fontWeight", "$value": 800 }
    }
  },

  "typography": {
    "$description": "lineHeight is a multiplier; $extensions.eyeq.lineHeightPx gives the px value for React Native. All numerals use tabular figures (fontVariant: ['tabular-nums']).",
    "hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontWeight": 800,
        "fontSize": "96px",
        "lineHeight": 0.917,
        "letterSpacing": "-1.92px"
      },
      "$extensions": {
        "eyeq": { "lineHeightPx": 88, "use": "XP earned, streak days on celebrations" }
      }
    },
    "display-xl": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontWeight": 800,
        "fontSize": "56px",
        "lineHeight": 0.929,
        "letterSpacing": "-0.56px"
      },
      "$extensions": {
        "eyeq": { "lineHeightPx": 52, "use": "Level-up title, landing hero (web clamps 48–88)" }
      }
    },
    "display-l": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontWeight": 700,
        "fontSize": "36px",
        "lineHeight": 1.0,
        "letterSpacing": "-0.36px"
      },
      "$extensions": {
        "eyeq": { "lineHeightPx": 36, "use": "Streak count, rank number, screen titles" }
      }
    },
    "display-m": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontWeight": 700,
        "fontSize": "26px",
        "lineHeight": 1.077,
        "letterSpacing": "-0.26px"
      },
      "$extensions": {
        "eyeq": { "lineHeightPx": 28, "use": "Card headlines, drill names, XP values" }
      }
    },
    "display-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Barlow Condensed",
        "fontWeight": 700,
        "fontSize": "20px",
        "lineHeight": 1.1,
        "letterSpacing": "0px"
      },
      "$extensions": {
        "eyeq": { "lineHeightPx": 22, "use": "Rank-row numbers, small stat values" }
      }
    },
    "title": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 800,
        "fontSize": "18px",
        "lineHeight": 1.333,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 24 } }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 500,
        "fontSize": "15px",
        "lineHeight": 1.467,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 22, "use": "Minimum body size" } }
    },
    "body-strong": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 800,
        "fontSize": "14px",
        "lineHeight": 1.43,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 20, "use": "Row titles, button labels at 14" } }
    },
    "body-s": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 600,
        "fontSize": "13px",
        "lineHeight": 1.385,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 18 } }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 600,
        "fontSize": "12px",
        "lineHeight": 1.333,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 16, "use": "Never smaller than 12 except label" } }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 800,
        "fontSize": "11px",
        "lineHeight": 1.273,
        "letterSpacing": "1.32px"
      },
      "$extensions": {
        "eyeq": {
          "lineHeightPx": 14,
          "textTransform": "uppercase",
          "use": "Section labels, chips' captions"
        }
      }
    },
    "button": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Manrope",
        "fontWeight": 800,
        "fontSize": "15px",
        "lineHeight": 1.2,
        "letterSpacing": "0px"
      },
      "$extensions": { "eyeq": { "lineHeightPx": 18 } }
    }
  },

  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "gutter": {
      "$type": "dimension",
      "$value": "20px",
      "$description": "Mobile screen side padding"
    },
    "card-padding": { "$type": "dimension", "$value": "16px" },
    "stack": {
      "$type": "dimension",
      "$value": "14px",
      "$description": "Default gap between cards on a screen"
    }
  },

  "radius": {
    "xs": { "$type": "dimension", "$value": "4px", "$description": "Bars, small marks" },
    "s": { "$type": "dimension", "$value": "8px", "$description": "Chips" },
    "control": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "Icon buttons, segmented items, small buttons"
    },
    "m": { "$type": "dimension", "$value": "14px", "$description": "Buttons, inputs, rows" },
    "card-s": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "Compact cards, video stage"
    },
    "l": { "$type": "dimension", "$value": "20px", "$description": "Cards, sheets (top corners)" },
    "full": {
      "$type": "dimension",
      "$value": "9999px",
      "$description": "Avatars, rings, pills, progress tracks"
    }
  },

  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "selected": {
      "$type": "dimension",
      "$value": "2px",
      "$description": "Selected plan card, focus"
    }
  },

  "elevation": {
    "$description": "Flat by default. Elevation is a lighter surface plus a brighter hairline. One real shadow, for sheets, modals and toasts. No blur anywhere.",
    "e0": {
      "$type": "shadow",
      "$value": {
        "color": "#00000000",
        "offsetX": "0px",
        "offsetY": "0px",
        "blur": "0px",
        "spread": "0px"
      }
    },
    "e1": {
      "$type": "shadow",
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$extensions": { "eyeq": { "androidElevation": 8 } }
    },
    "e1-up": {
      "$type": "shadow",
      "$value": {
        "color": "#00000073",
        "offsetX": "0px",
        "offsetY": "-8px",
        "blur": "24px",
        "spread": "0px"
      },
      "$extensions": { "eyeq": { "androidElevation": 8, "use": "Docked bars above the tab bar" } }
    }
  },

  "size": {
    "touch-min": { "$type": "dimension", "$value": "44px" },
    "button-l": { "$type": "dimension", "$value": "52px" },
    "button-m": { "$type": "dimension", "$value": "44px" },
    "button-s": { "$type": "dimension", "$value": "36px", "$description": "Admin / desktop only" },
    "input": { "$type": "dimension", "$value": "52px" },
    "input-admin": { "$type": "dimension", "$value": "40px" },
    "icon-s": { "$type": "dimension", "$value": "16px" },
    "icon-m": { "$type": "dimension", "$value": "20px" },
    "icon-l": { "$type": "dimension", "$value": "24px" },
    "icon-stroke": { "$type": "dimension", "$value": "2px" },
    "avatar-s": { "$type": "dimension", "$value": "28px" },
    "avatar-m": { "$type": "dimension", "$value": "36px" },
    "avatar-l": { "$type": "dimension", "$value": "64px" },
    "tabbar-height": {
      "$type": "dimension",
      "$value": "84px",
      "$description": "Includes 24px home-indicator inset"
    },
    "xp-bar-height": { "$type": "dimension", "$value": "10px" },
    "bar-height-s": { "$type": "dimension", "$value": "6px" },
    "ring-stroke": { "$type": "dimension", "$value": "10px" },
    "row-min": { "$type": "dimension", "$value": "52px" },
    "screen-width": {
      "$type": "dimension",
      "$value": "390px",
      "$description": "Mobile reference frame (390 × 844)"
    },
    "web-max-width": { "$type": "dimension", "$value": "1180px" }
  },

  "duration": {
    "instant": {
      "$type": "duration",
      "$value": "10ms",
      "$description": "Reduced-motion replacement for every animation"
    },
    "fast": { "$type": "duration", "$value": "150ms", "$description": "Fades, pressed state" },
    "base": { "$type": "duration", "$value": "220ms", "$description": "Line items, chips" },
    "loss": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "The only motion a loss state gets"
    },
    "bar": { "$type": "duration", "$value": "600ms", "$description": "XP bar fill" },
    "count": { "$type": "duration", "$value": "700ms", "$description": "XP count-up" },
    "rank": { "$type": "duration", "$value": "700ms", "$description": "Rank-row swap" },
    "flame": { "$type": "duration", "$value": "800ms", "$description": "Streak +1" },
    "badge": { "$type": "duration", "$value": "800ms", "$description": "Badge tile flip" },
    "celebrate": {
      "$type": "duration",
      "$value": "1100ms",
      "$description": "Level-up takeover entrance"
    },
    "max": {
      "$type": "duration",
      "$value": "1200ms",
      "$description": "Hard ceiling for any single moment"
    },
    "stagger": { "$type": "duration", "$value": "80ms" },
    "toast": { "$type": "duration", "$value": "3000ms" }
  },

  "easing": {
    "spring": {
      "$type": "cubicBezier",
      "$value": [0.34, 1.56, 0.64, 1],
      "$description": "Things that gain: flame, badges, chips popping"
    },
    "settle": {
      "$type": "cubicBezier",
      "$value": [0.2, 0.9, 0.2, 1],
      "$description": "Things that move: bars, rows, slides"
    },
    "standard": { "$type": "cubicBezier", "$value": [0.4, 0, 0.2, 1] },
    "out-quart": {
      "$type": "cubicBezier",
      "$value": [0.25, 1, 0.5, 1],
      "$description": "Number count-up"
    }
  },

  "haptic": {
    "$description": "expo-haptics mapping. Web: none.",
    "xp-landed": { "$type": "string", "$value": "impact.light" },
    "streak-plus": { "$type": "string", "$value": "impact.medium" },
    "level-up": { "$type": "string", "$value": "notification.success" },
    "badge": { "$type": "string", "$value": "impact.light" },
    "test-go": {
      "$type": "string",
      "$value": "none",
      "$description": "Phase 2 reaction test: no haptics during trials"
    }
  },

  "opacity": {
    "disabled": { "$type": "number", "$value": 0.4 },
    "pressed-overlay": { "$type": "number", "$value": 0.08 },
    "glow-rest": {
      "$type": "number",
      "$value": 0.18,
      "$description": "Streak flame glow after the +1 moment"
    }
  },

  "z": {
    "base": { "$type": "number", "$value": 0 },
    "dock": { "$type": "number", "$value": 10, "$description": "Bottom action bars, gap dock" },
    "tabbar": { "$type": "number", "$value": 20 },
    "toast": { "$type": "number", "$value": 30 },
    "sheet": { "$type": "number", "$value": 40 },
    "takeover": {
      "$type": "number",
      "$value": 50,
      "$description": "Level-up and badge celebrations"
    }
  },

  "game": {
    "$description": "Rule values the UI displays. Source of truth is the coach admin; these are defaults.",
    "xp-per-drill": { "$type": "number", "$value": 10 },
    "xp-session-bonus": { "$type": "number", "$value": 25 },
    "streak-multiplier-step": {
      "$type": "number",
      "$value": 0.1,
      "$description": "+10 % per 7 consecutive days"
    },
    "xp-daily-cap": { "$type": "number", "$value": 400 },
    "freeze-max-held": { "$type": "number", "$value": 2 },
    "video-done-threshold": {
      "$type": "number",
      "$value": 0.8,
      "$description": "Fraction watched before Mark done unlocks"
    },
    "test-clean-trials": {
      "$type": "number",
      "$value": 5,
      "$description": "Phase 2 reaction test"
    },
    "streak-nudge-time": { "$type": "string", "$value": "20:00" },
    "streak-last-call": {
      "$type": "string",
      "$value": "22:30",
      "$description": "21:00 for under-18 accounts"
    }
  }
}
